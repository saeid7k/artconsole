APP_NAME="ArtConsole"
APP_FULLNAME="ArtConsole Gallery Management"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.artconsole.io
APP_DOMAIN=app.artconsole.io
WEBSITE_URL="https://artconsole.io"

ADMIN_EMAIL="dev@liamsoft.com"
ADMIN_PHONE="4377768629"
ADMIN_DEFAULT_PASSWORD="12345678"

APP_LOCALE=en_CA
APP_FALLBACK_LOCALE=en_US
APP_FAKER_LOCALE=en_CA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
MAIL_LOG_CHANNEL=mail

LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME="ArtConsole Log"
LOG_SLACK_EMOJI=":boom:"
LOG_SLACK_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=artconsole
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=mysql

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST="smtp-relay.brevo.com"
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS="app@artconsole.io"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OPENCAGE_API_KEY=2658d7ab36f843c180e4809428520e06

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"

# Cashier
CASHIER_MODEL=App\Models\Gallery

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_TOKEN_WEBHOOK_SECRET=

# AI
GEMINI_API_KEY=

# Vite
